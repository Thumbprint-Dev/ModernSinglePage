# Which storefront the dev server proxies to when no --upstream is passed.
#
#   cp .env.example .env
#
# .env is gitignored, so each of us can point the same working tree at a
# different site without touching the repo.
#
# SITE_URL does the work: its first path segment becomes the local mount and
# the Four51 API app name (e.g. /WastePro/ -> /api/WastePro/*). SITE_NAME is
# only the label printed in the startup banner.
#
# Any site in the storefront-files buyersites.json works, e.g.
#   https://thumbprint.Four51OrderCloud.com/WastePro
#   https://thumbprint.Four51OrderCloud.com/ChildrensHealth
#   https://thumbprint.four51ordercloud.com/capitalvacations

SITE_NAME=Sandbox
SITE_URL=https://thumbprint.four51ordercloud.com/thumbprint_sandbox
